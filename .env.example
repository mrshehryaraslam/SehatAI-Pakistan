# ============================================
# SehatAI Pakistan — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---------- Database (MySQL / XAMPP) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sehatai_pakistan
DB_USER=root
DB_PASS=

# ---------- JWT Authentication ----------
# Generate a strong random string for production (min 64 chars).
# Example: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CHANGE_ME_set_a_strong_random_secret_here

# ---------- Google Gemini AI ----------
# Get your key from: https://aistudio.google.com/apikey
# Leave empty to use the offline rule-based triage engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------- Default Test Credentials ----------
# These are for LOCAL development only. Change in production.
# Admin:   admin@sehat.ai         / Admin@123
# Doctor:  ayesha.siddiqui@sehat.ai / Doctor@123
# Patient: ahmed.khan@gmail.com   / Patient@123
